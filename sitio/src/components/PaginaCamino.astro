---
// Página de un camino (experiencia): presentación, cómo es, próximos encuentros y lo práctico.
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Mandala from './Mandala.astro';
import BotonWa from './BotonWa.astro';
import TarjetaEncuentro from './TarjetaEncuentro.astro';
interface Props { x: CollectionEntry<'experiencias'>; seccion: string }
const { x, seccion } = Astro.props;
const d = x.data;
const encuentros = (await getCollection('encuentros', (e) => e.data.experiencia.id === x.id)).sort((a, b) => +a.data.fecha - +b.data.fecha);
const consulta = x.id === 'consultas';
const ROMANOS = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
const CUANTOS: Record<number, string> = { 2: 'Dos', 3: 'Tres', 4: 'Cuatro', 5: 'Cinco', 6: 'Seis', 7: 'Siete' };
const msg = consulta
  ? `Hola, quisiera agendar una consulta${d.tipos.length ? ` de ${d.tipos[0].toLowerCase()}` : ''}. ¿Qué horarios tienen?`
  : `Hola, quisiera saber cuándo es el próximo encuentro de ${d.nombre}.`;
---
<Base titulo={d.nombre} seccion={seccion} descripcion={d.intro} imagen={d.imagen} conBarra>
  <section class="heroe" style="min-height:clamp(620px,62vw,780px);padding:170px 0 100px;background:radial-gradient(120% 90% at 78% 30%,#3A2460 0%,#1E1A3F 45%,#14122C 100%)">
    <div aria-hidden="true" style="position:absolute;right:-140px;top:40px;width:min(760px,120vw);aspect-ratio:1;opacity:.35"><Mandala id="m-camino" size="100%" variante="anillo" grosor={1.2} clase="girar" /></div>
    <span class="estrella" aria-hidden="true" style="left:46%;top:210px"></span>
    <span class="estrella s" aria-hidden="true" style="left:30%;top:520px;animation-delay:1.4s"></span>
    <div class="wrap grid12" style="align-items:center">
      <div class="c7 stack g22">
        <a class="enlace" href="/experiencias/" style="font-size:15px;color:var(--crema)">← Experiencias</a>
        <p class="lbl">{d.etiqueta}</p>
        <h1 class="d h-xxl">{d.nombre}</h1>
        <p class="p p-l" style="max-width:560px">{d.intro}</p>
        <div class="fila oculto-barra">
          <BotonWa msg={msg} texto={consulta ? 'Agendar por WhatsApp' : 'Quiero participar'} />
          {!consulta && <a class="btn b-lc btn-l" href="#fechas">Ver próximas fechas</a>}
        </div>
      </div>
      <div class="c5" style="display:flex;justify-content:center">
        <div style="transform:rotate(4deg)"><span class="naipe lift" style="width:min(340px,58vw);box-shadow:0 34px 70px rgba(0,0,0,.5)"><Image src={d.carta} alt="" widths={[340, 680]} sizes="340px" loading="eager" /></span></div>
      </div>
    </div>
  </section>

  {d.origen && (
    <section class="sec bg-noche">
      <div class="wrap grid12">
        <p class="d c6" style="font-size:clamp(30px,3.4vw,44px);line-height:1.14">{consulta ? 'Una herramienta' : 'Cada persona participa'} <span class="t2">{consulta ? 'para formular mejores preguntas' : 'a su manera, desde su propia creencia'}</span></p>
        <div class="c6 stack g18">
          <p class="p">{d.origen}</p>
          {d.cuidados && <p class="ps nota">{d.cuidados}</p>}
          {d.guia && <p class="ps">Guía: {d.guia}</p>}
        </div>
      </div>
    </section>
  )}

  {(d.pasos.length > 0 || d.desarrollo) && (
    <section class="sec bg-onda" aria-labelledby="c-pasos">
      <div class="wrap grid12">
        <div class="c4 sticky stack g22">
          <p class="lbl">{consulta ? 'Cómo se agenda' : 'Cómo es un encuentro'}</p>
          <h2 id="c-pasos" class="d h-m">{d.pasos.length ? <>{CUANTOS[d.pasos.length] ?? 'Los'} <span class="t2">{consulta ? 'pasos' : 'movimientos'}</span></> : <>Cómo <span class="t2">se vive</span></>}</h2>
          {d.desarrollo && <p class="p">{d.desarrollo}</p>}
        </div>
        {d.pasos.length > 0 && (
          <div class="c8" style="position:relative">
            <span aria-hidden="true" style="position:absolute;left:27px;top:28px;bottom:60px;width:2px;background:rgba(232,199,138,.16)"><span class="hilo" style="position:absolute;inset:0;background:linear-gradient(180deg,#F3D9A0,#CFA24E 50%,#9C6FB8)"></span></span>
            <ol style="margin:0;padding:0 0 0 88px;list-style:none">
              {d.pasos.map((p, i) => (
                <li class="revela stack g10" style="position:relative;padding:0 0 56px">
                  <span aria-hidden="true" style="position:absolute;left:-88px;top:0;display:flex;align-items:center;justify-content:center;width:56px;height:56px;border-radius:50%;background:#1A1736;box-shadow:inset 0 0 0 1.5px rgba(232,199,138,.6),0 0 28px rgba(207,162,78,.2)"><span class="num" style="font-size:20px">{ROMANOS[i] ?? i + 1}</span></span>
                  <h3 class="d" style="font-size:clamp(26px,2.6vw,36px);padding-top:8px">{p.titulo}</h3>
                  <p class="p" style="max-width:560px">{p.texto}</p>
                </li>
              ))}
            </ol>
          </div>
        )}
      </div>
    </section>
  )}

  {consulta && d.tipos.length > 0 && (
    <section class="sec bg-noche" aria-labelledby="c-tipos">
      <div class="wrap grid12">
        <div class="c5 stack g22"><p class="lbl">Consultas</p><h2 id="c-tipos" class="d h-m">¿Qué te <span class="t2">gustaría?</span></h2><p class="p">Elige la consulta y te escribimos para acordar horario y modalidad.</p></div>
        <ul class="c7 votos">
          {d.tipos.map((t) => (
            <li class="voto" style="grid-template-columns:minmax(0,1fr) auto;align-items:center;padding:22px 0">
              <span class="d" style="font-size:clamp(22px,2.4vw,30px)">{t}</span>
              <BotonWa msg={`Hola, quisiera agendar una consulta de ${t.toLowerCase()}. ¿Qué horarios tienen?`} texto="Agendar" grande={false} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {!consulta && (
    <section id="fechas" class="sec bg-noche-bosque">
      <div class="wrap stack g28">
        <div class="cabeza"><h2 class="d h-l">Próximas <span class="t2">fechas</span></h2><a class="btn b-lc" href="/agenda/">Ver agenda completa</a></div>
        <div class="cols-3" data-lista-fechas="camino">{encuentros.map((e) => <TarjetaEncuentro e={e} alto={460} />)}</div>
        <div class="stack g14" data-vacio-fechas="camino" hidden style="align-items:flex-start">
          <p class="p">Por ahora no hay fechas abiertas de este camino.</p>
          <BotonWa msg={`Hola, ¿me avisan cuando abran fecha de ${d.nombre}?`} texto="Avísame de la próxima fecha" grande={false} />
        </div>
      </div>
    </section>
  )}

  {d.ficha.length > 0 && (
    <section class="sec bg-bosque">
      <div class="wrap grid12">
        <div class="c5 stack g22">
          <p class="lbl">Antes de venir</p>
          <h2 class="d h-m">Lo <span class="t2">práctico</span></h2>
          <p class="p">Te confirmamos fecha, hora y lugar por WhatsApp al inscribirte.</p>
          <BotonWa msg={msg} />
        </div>
        <dl class="c7" style="margin:0;border-bottom:1px solid var(--linea)">
          {d.ficha.map((f) => <div class="voto" style="grid-template-columns:minmax(110px,180px) minmax(0,1fr);align-items:baseline;padding:24px 0;border-bottom:0"><dt class="lbl lbl-s">{f.dato}</dt><dd class="p" style="margin:0;color:var(--crema)">{f.valor}</dd></div>)}
        </dl>
      </div>
    </section>
  )}

  <div class="barra"><BotonWa msg={msg} texto={consulta ? 'Agendar por WhatsApp' : 'Quiero participar'} full grande={false} /></div>
</Base>
