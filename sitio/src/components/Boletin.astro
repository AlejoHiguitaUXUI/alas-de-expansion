---
// Suscripción al boletín (doble confirmación por correo, vía Brevo).
interface Props { id: string; etiqueta?: string; compacto?: boolean }
const { id, etiqueta = 'Recibe novedades en tu correo', compacto = false } = Astro.props;
---
<form class="stack g10" data-boletin novalidate style="width:100%;max-width:560px">
  <label for={`${id}-correo`} class:list={[compacto ? 'sr' : '']} style="font-size:16px;font-weight:600">{etiqueta}</label>
  <div class="bol-fila">
    <input id={`${id}-correo`} name="correo" type="email" autocomplete="email" required placeholder="tu@correo.com" />
    <button type="submit" class="btn b-crema">Suscribirme</button>
  </div>
  <div class="trampa" aria-hidden="true"><label>No llenar <input name="sitio" tabindex="-1" autocomplete="off" /></label></div>
  <div class="chk" style="color:var(--texto-2)"><input id={`${id}-datos`} type="checkbox" style="accent-color:#CFA24E;width:24px;height:24px" /><label for={`${id}-datos`}>Acepto la <a href="/legal/datos/">política de tratamiento de datos</a>.</label></div>
</form>
