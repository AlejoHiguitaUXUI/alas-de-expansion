---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { Image, Picture, getImage } from 'astro:assets';
import Mandala from '../components/Mandala.astro';
import Ave from '../components/Ave.astro';
import BotonWa from '../components/BotonWa.astro';
import Boletin from '../components/Boletin.astro';
import TarjetaEncuentro from '../components/TarjetaEncuentro.astro';
import TarjetaCamino from '../components/TarjetaCamino.astro';
import TarjetaProducto from '../components/TarjetaProducto.astro';
import { fecha, iso } from '../lib/sitio';
import heroDesk from '../assets/hero-desktop.jpg';
import heroMovil from '../assets/hero-movil.jpg';
import cierre from '../assets/cierre.jpg';

const encuentros = (await getCollection('encuentros')).sort((a, b) => +a.data.fecha - +b.data.fecha);
const experiencias = (await getCollection('experiencias')).sort((a, b) => a.data.orden - b.data.orden);
const productos = (await getCollection('productos')).sort((a, b) => a.data.orden - b.data.orden);
const destacados = productos.filter((p) => p.data.destacado && p.data.categoria !== 'chichas').slice(0, 4);
const cartas = experiencias.filter((x) => x.id !== 'consultas').map((x) => x.data.carta);
const imgsCartas = await Promise.all(cartas.slice(0, 4).map((c) => getImage({ src: c, width: 480, format: 'webp' })));
const expPor = Object.fromEntries(experiencias.map((x) => [x.id, x]));
const heroD = await getImage({ src: heroDesk, width: 1920, format: 'webp' });
const heroM = await getImage({ src: heroMovil, width: 900, format: 'webp' });

const FRASES = [
  ['Una pausa', 'para volver a escucharte.'],
  ['Honramos los ciclos de la tierra', 'y el silencio que permite escuchar.'],
  ['Elegimos el amor sobre el miedo,', 'la escucha sobre el juicio.'],
  ['La expansión comienza', 'en el interior.'],
  ['Expande tu conciencia,', 'expande tu ser.'],
];
const POS = [['3%', '9%', 1], ['calc(97% - .8 * var(--wq))', '17%', 0.8], ['6%', '57%', 0.88], ['calc(96% - 1.12 * var(--wq))', '49%', 1.12]];
const VOTOS = [
  ['I', 'Honramos el origen', 'Contamos de dónde viene cada práctica y a quién pertenece, sin apropiarnos de los saberes de otros pueblos.'],
  ['II', 'Tú decides', 'Participas libremente, con información clara antes de cada encuentro y con tu consentimiento. Puedes preguntar, poner límites o retirarte.'],
  ['III', 'Acompañamos, no prometemos', 'No ofrecemos curaciones ni resultados espirituales garantizados. Cada proceso es tuyo.'],
  ['IV', 'Tu salud va primero', 'Nuestras prácticas no reemplazan diagnósticos ni tratamientos médicos o psicológicos.'],
];
const waGeneral = 'Hola, quisiera conversar y conocer más sobre Alas de Expansión.';
---
<Base titulo="Inicio" sinFab imagen={heroDesk}>
  <Fragment slot="head">
    <link rel="preload" as="image" href={heroM.src} media="(max-width: 760px)" />
    <link rel="preload" as="image" href={heroD.src} media="(min-width: 761px)" />
  </Fragment>

  <section class="heroe heroe-inicio" data-heroe>
    <picture class="foto" style="position:absolute;inset:0">
      <source media="(max-width: 760px)" srcset={heroM.src} />
      <img src={heroD.src} alt="" class="cubre" style="object-position:center 40%" fetchpriority="high" />
    </picture>
    <div class="blob drift1" data-blob="a" aria-hidden="true" style="left:-160px;top:-60px;width:min(760px,90vw);height:640px;background:#7B3F8E;opacity:.4"></div>
    <div class="blob drift2" data-blob="b" aria-hidden="true" style="right:-200px;top:200px;width:min(700px,90vw);height:640px;background:#34338A;opacity:.36"></div>
    <div class="velo" aria-hidden="true" style="background:linear-gradient(90deg,rgba(20,18,44,.75) 0%,rgba(20,18,44,.2) 55%,rgba(20,18,44,0) 100%),linear-gradient(180deg,rgba(20,18,44,0) 55%,#14122C 100%)"></div>
    <span class="estrella" aria-hidden="true" style="left:62%;top:160px"></span>
    <span class="estrella s" aria-hidden="true" style="left:40%;top:230px;animation-delay:1.6s"></span>
    <div aria-hidden="true" class="mandala-heroe" data-mandala-heroe><Mandala id="m-heroe" size="100%" clase="girar" /></div>
    <div class="wrap" style="display:flex;align-items:flex-end;justify-content:space-between;gap:48px;flex-wrap:wrap">
      <div class="stack g22" style="flex:1 1 520px;max-width:760px">
        <Ave w={64} clase="solo-movil" />
        <p class="lbl solo-desk">Alas de Expansión · Medellín</p>
        <h1 class="d h-xxl">Expande tu conciencia, <span class="t2">expande tu ser</span></h1>
        <p class="p p-l" style="max-width:560px">Un espacio para hacer una pausa, escucharte y reconectar con la naturaleza, la comunidad y la memoria de la vida.</p>
        <div class="fila fila-hero">
          <BotonWa msg={waGeneral} icono />
          <a class="btn b-lc btn-l" href="/agenda/">Ver próximos encuentros</a>
        </div>
      </div>
      <div class="proximo" data-lista-fechas="heroe" data-limite="1">
        {encuentros.map((e) => {
          const x = expPor[e.data.experiencia.id];
          return (
            <a class="glass press lift tarjeta-proximo" href={`/agenda/${e.id}/`} data-fecha={iso(e.data.fecha)} data-proximo>
              <span class="foto"><Picture src={e.data.imagen ?? x.data.imagen} alt="" formats={['avif', 'webp']} widths={[400, 760]} sizes="380px" loading="eager" /></span>
              <span class="stack g14" style="padding:18px 8px 8px">
                <span class="stack g6"><span class="lbl lbl-s">Próximo encuentro</span><span class="d" style="font-size:28px">{e.data.titulo}</span></span>
                <span class="tiles"><span class="tile"><span class="k">Fecha</span><span class="v">{fecha(e.data.fecha)}</span></span><span class="tile"><span class="k">Aporte</span><span class="v">{e.data.valor}</span></span></span>
                <span class="btn b-crema btn-full">Ver encuentro</span>
              </span>
            </a>
          );
        })}
      </div>
    </div>
  </section>

  <section class="secuencia" data-secuencia data-spy="esencia" aria-label="Qué es Alas de Expansión">
    <div class="fijo">
      <div class="velo" aria-hidden="true" style="background:radial-gradient(60% 55% at 50% 50%,rgba(123,63,142,.28) 0%,rgba(20,18,44,0) 70%)"></div>
      <div class="mandala-sec" aria-hidden="true" data-q="mand"><Mandala id="m-sec" size="100%" variante="semilla" grosor={1.3} trazo /></div>
      <span class="estrella" aria-hidden="true" style="left:22%;top:18%"></span>
      <span class="estrella s" aria-hidden="true" style="left:70%;top:30%;animation-delay:1.3s"></span>
      <span class="estrella s" aria-hidden="true" style="left:40%;top:80%;animation-delay:2.4s;background:#CDB0EE"></span>
      <span class="estrella" aria-hidden="true" style="left:86%;top:74%;animation-delay:.6s"></span>
      {imgsCartas.map((c, k) => (
        <img class="carta-q" src={c.src} alt="" aria-hidden="true" data-q="carta" style={`left:${POS[k][0]};top:${POS[k][1]};width:calc(${POS[k][2]} * var(--wq))`} />
      ))}
      <Ave w={96} attrs={{ 'data-q': 'ave', style: 'position:absolute;left:0;top:0;opacity:.9;will-change:transform;transform:translate3d(-140px,170px,0)' }} />
      <p class="lbl" style="position:absolute;left:0;right:0;top:116px;text-align:center">Qué es Alas de Expansión</p>
      {FRASES.map(([a, b]) => <p class="d frase" data-q="frase">{a} <span class="t2">{b}</span></p>)}
      <div class="cta-sec" data-q="cta"><a class="btn b-lc btn-l" href="/esencia/">Conocer nuestra esencia →</a></div>
      <div class="barra-sec" aria-hidden="true"><div data-q="bar"></div></div>
    </div>
  </section>

  <section class="wrap stack g28" data-spy="agenda" style="padding-top:clamp(48px,8vw,80px);padding-bottom:clamp(24px,4vw,40px)">
    <div class="cabeza"><h2 class="d h-l">Próximos <span class="t2">encuentros</span></h2><a class="btn b-lc" href="/agenda/">Ver agenda completa</a></div>
    <div class="cols-3 carrusel" data-lista-fechas="inicio" data-limite="3">
      {encuentros.map((e) => <TarjetaEncuentro e={e} />)}
    </div>
    <p class="ps" data-vacio-fechas="inicio" hidden>Pronto publicaremos nuevas fechas. Escríbenos por WhatsApp y te avisamos.</p>
  </section>

  <section data-spy="experiencias" style="margin-top:clamp(40px,8vw,80px);padding:clamp(64px,10vw,110px) 0;background:linear-gradient(180deg,#14122C 0%,#0F241F 100%)">
    <div class="wrap stack g40">
      <div class="cabeza"><h2 class="d h-l">Caminos</h2><p class="ps" style="max-width:420px">Cinco formas de hacer una pausa y volver a escucharte. Elige una carta.</p></div>
      <div class="cols-5">{experiencias.map((x) => <TarjetaCamino x={x} />)}</div>
    </div>
  </section>

  <section data-spy="productos" class="bg-bosque" style="padding:clamp(24px,4vw,40px) 0 clamp(64px,10vw,110px)">
    <div class="wrap stack g28">
      <div class="cabeza"><h2 class="d h-l">De la tierra <span class="t2">a tu mesa</span></h2><a class="btn b-lc" href="/productos/">Ver todos los productos</a></div>
      <div class="cols-4">{destacados.map((p) => <TarjetaProducto p={p} />)}</div>
    </div>
  </section>

  <section class="bg-bosque" aria-labelledby="d-compromiso" style="padding:clamp(32px,5vw,60px) 0 clamp(80px,12vw,150px)">
    <div class="wrap grid12">
      <div class="c5 sticky stack g22">
        <span class="lbl">Nuestro compromiso</span>
        <h2 id="d-compromiso" class="d h-m">Cuidamos el camino <span class="t2">que compartimos</span></h2>
        <p class="p" style="max-width:440px">Lo que hacemos toca lo más íntimo de cada persona. Estos son los acuerdos con los que acompañamos cada encuentro y cada producto.</p>
        <a class="enlace" href="/preguntas/">Preguntas frecuentes y cuidado →</a>
      </div>
      <ol class="c7 votos">
        {VOTOS.map(([n, t, d]) => (
          <li class="voto voto-num"><span class="num" aria-hidden="true">{n}</span><div class="stack g10"><h3 class="d" style="font-size:28px">{t}</h3><p class="p" style="max-width:560px">{d}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="heroe" style="padding:clamp(140px,18vw,220px) 0 clamp(72px,10vw,120px)">
    <span class="foto" style="position:absolute;inset:0"><Image src={cierre} alt="" widths={[800, 1400, 1920]} sizes="100vw" class="cubre" style="object-position:center 60%" /></span>
    <div class="velo" aria-hidden="true" style="background:linear-gradient(180deg,#0F241F 0%,rgba(15,36,31,0) 22%,rgba(20,18,44,0) 60%,rgba(20,18,44,.7) 100%)"></div>
    <div class="wrap" style="display:flex;justify-content:center">
      <div class="glass stack g22" style="width:100%;max-width:820px;padding:clamp(28px,4vw,48px);border-radius:36px;align-items:center;text-align:center">
        <h2 class="d h-l">Cada camino tiene <span class="t2">su propio ritmo</span></h2>
        <p class="p" style="max-width:560px">Escríbenos y conversemos sobre el encuentro o el producto que te llama.</p>
        <BotonWa msg={waGeneral} />
        <div style="width:100%;height:1px;background:rgba(237,227,240,.18);margin:10px 0"></div>
        <Boletin id="inicio" />
      </div>
    </div>
  </section>
</Base>

<style>
  .mandala-heroe { position: absolute; right: 8%; top: 120px; width: min(520px, 80vw); aspect-ratio: 1; opacity: .8; will-change: transform; pointer-events: none; }
  .proximo { flex: 0 0 380px; max-width: 100%; }
  .tarjeta-proximo { display: flex; flex-direction: column; padding: 12px; border-radius: 30px; color: var(--crema); text-decoration: none; }
  .tarjeta-proximo:hover { color: var(--crema); }
  .tarjeta-proximo > .foto { display: block; height: 200px; border-radius: 20px; }
  .secuencia { position: relative; height: 3400px; background: var(--noche); --wq: max(60px, min(240px, (100vw - min(760px, 86vw)) / 2 - 7vw)); }
  .fijo { position: sticky; top: 0; height: 100vh; height: 100svh; min-height: 620px; overflow: hidden; }
  .mandala-sec { position: absolute; left: 50%; top: 50%; width: min(780px, 92vw); aspect-ratio: 1; translate: -50% -50%; opacity: .2; will-change: transform; }
  .carta-q { position: absolute; aspect-ratio: 3 / 4; object-fit: cover; border-radius: 14px; box-shadow: 0 30px 60px rgba(0,0,0,.5); opacity: 0; will-change: transform, opacity; }
  .frase { position: absolute; z-index: 2; left: 50%; top: 50%; width: min(760px, 86vw); margin-left: calc(min(760px, 86vw) / -2); text-align: center; font-size: clamp(34px, 5vw, 68px); line-height: 1.08; text-shadow: 0 4px 30px rgba(10,8,24,.6); opacity: 0; transform: translate3d(0, -50%, 0); will-change: transform, opacity; }
  .cta-sec { position: absolute; left: 0; right: 0; bottom: 110px; display: flex; justify-content: center; opacity: 0; pointer-events: none; transition: opacity 300ms ease; }
  .barra-sec { position: absolute; left: 50%; bottom: 64px; width: 240px; margin-left: -120px; height: 2px; border-radius: 2px; background: rgba(245,237,225,.15); }
  .barra-sec > div { width: 100%; height: 100%; border-radius: 2px; background: var(--oro-claro); transform: scaleX(0); transform-origin: left center; }
  @media (max-width: 900px) {
    .proximo { flex-basis: 100%; }
    .tarjeta-proximo { flex-direction: row; align-items: center; gap: 14px; border-radius: 24px; }
    .tarjeta-proximo > .foto { flex-shrink: 0; width: 72px; height: 72px; border-radius: 16px; }
    .tarjeta-proximo .stack { padding: 0 !important; gap: 4px; flex: 1; }
    .tarjeta-proximo .tiles, .tarjeta-proximo .btn { display: none; }
    .tarjeta-proximo .d { font-size: 20px !important; }
    .mandala-heroe { right: -140px; top: 90px; width: 320px; opacity: .55; }
    .secuencia { height: 2600px; }
    .carta-q { display: none; }
  }
  @media (max-width: 900px) {
    .carrusel { display: flex; overflow-x: auto; overscroll-behavior-x: contain; scroll-snap-type: x mandatory; gap: 14px; margin: 0 calc(var(--gutter) * -1); padding: 0 var(--gutter) 6px; scroll-padding-inline: var(--gutter); scrollbar-width: none; -webkit-overflow-scrolling: touch; }
    .carrusel::-webkit-scrollbar { display: none; }
    .carrusel > :global(*) { flex: 0 0 min(82%, 400px); scroll-snap-align: start; }
  }
  /* Tabletas y teléfonos horizontales: la secuencia cabe en la altura real */
  @media (max-height: 600px) {
    .fijo { min-height: 0; }
    .frase { font-size: clamp(26px, min(5vw, 9vh), 68px); }
    .cta-sec { bottom: 70px; }
    .barra-sec { bottom: 36px; }
    .secuencia > .fijo > .lbl { top: 84px !important; }
    .heroe-inicio { min-height: 0; padding-top: 110px; }
  }
  @media (min-width: 901px) and (max-width: 1080px) { .mandala-heroe { opacity: .42; right: -4%; } }
</style>

<script>
  // Secuencia "Qué es Alas de Expansión": frases, cartas, mandala y ave guiados por el scroll.
  const rm = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const root = document.querySelector<HTMLElement>('[data-secuencia]');
  const cl = (v: number) => Math.min(1, Math.max(0, v));
  const ease = (v: number) => 1 - Math.pow(1 - v, 3);
  const hex = (h: string) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16));
  const mix = (a: string, b: string, t: number) => { const x = hex(a); const y = hex(b); return `rgb(${x.map((v, i) => Math.round(v + (y[i] - v) * t)).join(',')})`; };
  const tri = (arr: string[], p: number) => (p < 0.5 ? mix(arr[0], arr[1], p * 2) : mix(arr[1], arr[2], (p - 0.5) * 2));
  const CQ = [[-1, -16], [1, 14], [-1, 10], [1, -10]];
  let cur = 0, target = 0, raf = 0;
  const frases = root ? Array.from(root.querySelectorAll<HTMLElement>('[data-q="frase"]')) : [];
  const cartas = root ? Array.from(root.querySelectorAll<HTMLElement>('[data-q="carta"]')) : [];
  const mand = root?.querySelector<HTMLElement>('[data-q="mand"]');
  const mandG = root?.querySelector<SVGGElement>('[data-trazo]');
  const ave = root?.querySelector<SVGElement>('[data-q="ave"]');
  const cta = root?.querySelector<HTMLElement>('[data-q="cta"]');
  const bar = root?.querySelector<HTMLElement>('[data-q="bar"]');
  const blobA = document.querySelector<HTMLElement>('[data-blob="a"]');
  const blobB = document.querySelector<HTMLElement>('[data-blob="b"]');
  const mHeroe = document.querySelector<HTMLElement>('[data-mandala-heroe]');

  const aplicar = (qp: number) => {
    if (!root) return;
    root.style.background = tri(['#14122C', '#22183F', '#0F241F'], qp);
    const n = frases.length;
    frases.forEach((el, i) => {
      const t = qp * n - i;
      let op = cl(1.5 - Math.abs(t - 0.5) * 2.6);
      let y = Math.max(-90, Math.min(90, (0.5 - t) * 90));
      if ((i === 0 && t < 0.5) || (i === n - 1 && t > 0.5)) { op = 1; y = 0; }
      if (rm) y = 0;
      el.style.opacity = op.toFixed(3);
      el.style.transform = `translate3d(0, calc(-50% + ${y.toFixed(1)}px), 0) scale(${(0.96 + 0.04 * op).toFixed(3)})`;
    });
    cartas.forEach((el, k) => {
      const c = CQ[k] || [1, 0];
      const e = ease(cl(qp * 5 - k * 0.9 - 0.3));
      const tx = rm ? 0 : (1 - e) * 380 * c[0];
      const ty = rm ? 0 : (qp - 0.5) * 160 * (k % 2 ? 1 : -1);
      const r = rm ? c[1] : c[1] + (1 - e) * 22 * c[0];
      el.style.opacity = e.toFixed(3);
      el.style.transform = `translate3d(${tx.toFixed(1)}px,${ty.toFixed(1)}px,0) rotate(${r.toFixed(2)}deg)`;
    });
    if (mand) mand.style.transform = rm ? 'none' : `translate3d(0,${((0.5 - qp) * 90).toFixed(1)}px,0) rotate(${(qp * 300).toFixed(2)}deg) scale(${(0.7 + 0.55 * qp).toFixed(3)})`;
    if (mandG) mandG.style.strokeDashoffset = rm ? '0' : (1200 * (1 - cl(qp * 4))).toFixed(1);
    if (ave) { const w = root.clientWidth || 1440; const x = rm ? w * 0.8 : (-0.1 + qp * 1.18) * w; const y = 170 + Math.sin(qp * Math.PI * 2) * 60; ave.style.transform = `translate3d(${x.toFixed(1)}px,${y.toFixed(1)}px,0)`; }
    if (cta) { const on = qp > 0.86; cta.style.opacity = on ? '1' : '0'; cta.style.pointerEvents = on ? 'auto' : 'none'; }
    if (bar) bar.style.transform = `scaleX(${qp.toFixed(4)})`;
  };
  const tick = () => {
    raf = 0; const d = target - cur;
    cur = Math.abs(d) < 0.0005 ? target : cur + d * 0.12;
    aplicar(cur);
    if (cur !== target) raf = requestAnimationFrame(tick);
  };
  const medir = () => {
    const st = scrollY;
    if (root) { const r = root.getBoundingClientRect(); const span = r.height - innerHeight; target = span > 0 ? cl(-r.top / span) : 0; }
    const p = cl(st / 3000);
    if (blobA) blobA.style.background = tri(['#7B3F8E', '#B4552F', '#2E5A48'], p);
    if (blobB) blobB.style.background = tri(['#34338A', '#7B3F8E', '#B4552F'], p);
    if (mHeroe && !rm) mHeroe.style.transform = `rotate(${(st * 0.08).toFixed(2)}deg)`;
    if (!raf) raf = requestAnimationFrame(tick);
  };
  addEventListener('scroll', medir, { passive: true });
  addEventListener('resize', medir, { passive: true });
  medir();
</script>
