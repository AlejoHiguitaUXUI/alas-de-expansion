---
import Base from '../../layouts/Base.astro';
import { getCollection, getEntry, render } from 'astro:content';
import { Picture } from 'astro:assets';
import TarjetaArticulo from '../../components/TarjetaArticulo.astro';
import { CAT_BITACORA, fechaCorta } from '../../lib/sitio';
import { urlExp, urlProd, u } from '../../lib/rutas';

export async function getStaticPaths() {
  const arts = await getCollection('bitacora');
  return arts.map((a) => ({ params: { id: a.id }, props: { a } }));
}
const { a } = Astro.props;
const d = a.data;
const { Content } = await render(a);
const exp = d.experiencia ? await getEntry(d.experiencia) : undefined;
const prod = d.producto ? await getEntry('productos', d.producto) : undefined;
const vive = exp ? { tipo: exp.data.etiqueta, nombre: exp.data.nombre, href: urlExp(exp.id) } : prod ? { tipo: 'PRODUCTO', nombre: prod.data.nombre, href: urlProd(prod.id) } : { tipo: 'EXPERIENCIAS', nombre: 'Los cinco caminos', href: u('/experiencias/') };
const rel = (await getCollection('bitacora')).filter((x) => x.id !== a.id).sort((x, y) => +y.data.fecha - +x.data.fecha).slice(0, 3);
---
<Base titulo={d.titulo} seccion="bitacora" descripcion={d.resumen} imagen={d.imagen}>
  <section class="heroe" style="min-height:clamp(520px,50vw,640px);padding:150px 0 64px">
    <span class="foto" style="position:absolute;inset:0"><Picture src={d.imagen} alt="" formats={['avif', 'webp']} widths={[800, 1400, 1920]} sizes="100vw" class="cubre" loading="eager" /></span>
    <div class="velo" style="background:linear-gradient(180deg,rgba(20,18,44,.45) 0%,rgba(20,18,44,.1) 35%,rgba(20,18,44,.75) 75%,#14122C 100%)"></div>
    <div class="wrap stack g22">
      <a class="enlace" href={u("/bitacora/")} style="font-size:15px;color:var(--crema)">← Bitácora</a>
      <p class="lbl">{CAT_BITACORA[d.categoria]}</p>
      <h1 class="d h-xl" style="max-width:980px">{d.titulo}</h1>
      <p class="p p-l" style="max-width:640px">{d.resumen}</p>
    </div>
  </section>
  <section class="bg-noche" style="padding:40px 0 120px">
    <div class="wrap grid12">
      <aside class="c3 sticky stack g6" style="padding-top:14px;border-top:1px solid rgba(232,199,138,.3)">
        <span class="lbl" style="font-size:11px">Escribe</span><span style="font-weight:600">{d.autor}</span>
        <span class="ps" style="margin-top:10px">{fechaCorta(d.fecha)}</span><span class="ps">{d.minutos} min de lectura</span>
      </aside>
      <article class="c7 stack g22">
        <div class="prosa"><Content /></div>
        {d.cita && <blockquote style="margin:20px 0;padding:4px 0 4px 32px;border-left:2px solid var(--oro)"><p class="d" style="font-size:clamp(28px,3vw,38px);line-height:1.16">{d.cita}</p></blockquote>}
        {d.fuentes && <div class="stack g10" style="padding-top:24px;border-top:1px solid var(--linea)"><h2 class="lbl lbl-s">Fuentes y cuidado</h2><p class="ps">{d.fuentes}</p></div>}
        <a class="press" href={vive.href} style="display:flex;align-items:center;justify-content:space-between;gap:20px;margin-top:18px;padding:26px 0;border-top:1px solid var(--linea);border-bottom:1px solid var(--linea);color:var(--crema);text-decoration:none">
          <span class="stack g10"><span class="lbl lbl-s">Vive esta práctica · {vive.tipo}</span><span class="d" style="font-size:30px">{vive.nombre}</span></span>
          <span aria-hidden="true" style="font-size:26px;color:var(--oro-claro)">→</span>
        </a>
      </article>
    </div>
  </section>
  <section style="padding:100px 0 140px;background:linear-gradient(180deg,#14122C,#0F241F)">
    <div class="wrap stack g40">
      <h2 class="d h-m">Sigue <span class="t2">leyendo</span></h2>
      <div class="cols-3" style="gap:32px">{rel.map((x) => <TarjetaArticulo a={x} />)}</div>
    </div>
  </section>
</Base>
