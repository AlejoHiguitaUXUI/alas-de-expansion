---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import { getImage, Image } from 'astro:assets';
import Icono from '../components/Icono.astro';
import BotonWa from '../components/BotonWa.astro';
import { ajustes, MENU, waHref } from '../lib/sitio';
import wordmark from '../assets/logo/wordmark-claro.png';
import lockup from '../assets/logo/lockup-vertical.png';
import heroMovil from '../assets/hero-movil.jpg';

interface Props {
  titulo: string;
  descripcion?: string;
  seccion?: string;
  sinFab?: boolean;
  conBarra?: boolean;
  imagen?: ImageMetadata;
}
const { titulo, descripcion = 'Un espacio para hacer una pausa, escucharte y reconectar con la naturaleza, la comunidad y la memoria de la vida. Encuentros y productos de la tierra en Medellín.', seccion = '', sinFab = false, conBarra = false, imagen } = Astro.props;
const tituloCompleto = titulo === 'Inicio' ? 'Alas de Expansión · Expande tu conciencia, expande tu ser' : `${titulo} · Alas de Expansión`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const og = imagen ? await getImage({ src: imagen, width: 1200, format: 'jpg' }) : await getImage({ src: heroMovil, width: 1200, format: 'jpg' });
const fondoMenu = await getImage({ src: heroMovil, width: 800, format: 'webp' });

// Datos mínimos de los productos para el pedido (se guarda en el navegador).
const productos = await getCollection('productos');
const datosPedido = await Promise.all(
  productos.map(async (p) => ({
    id: p.id,
    nombre: p.data.nombre,
    precio: p.data.precio ?? null,
    cat: p.data.categoria,
    soloMedellin: p.data.solo_medellin,
    disponible: p.data.disponible,
    img: (await getImage({ src: p.data.imagen, width: 160, height: 160, fit: 'cover', format: 'webp' })).src,
  })),
);
const waGeneral = 'Hola, quisiera conversar y conocer más sobre Alas de Expansión.';
const ga = (ajustes.google_analytics || '').trim();
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta name="theme-color" content="#14122C" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:site_name" content="Alas de Expansión" />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(og.src, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body data-wa-num={(ajustes.whatsapp || '').replace(/\D/g, '')} data-ga={ga || undefined} class:list={{ 'con-barra': conBarra }}>
    <a class="sr" href="#contenido">Saltar al contenido</a>

    <header class="cabecera glass" data-cabecera>
      <div class="wrap">
        <a class="marca press" href="/" aria-label="Alas de Expansión, inicio">
          <Image src={wordmark} alt="Alas de Expansión" height={54} widths={[200, 400]} sizes="200px" loading="eager" />
        </a>
        <nav class="nav-p" aria-label="Menú principal">
          {MENU.map((m) => <a class="nav" href={m.href} aria-current={seccion === m.id ? 'page' : undefined} data-spy-link={m.id}>{m.label}</a>)}
        </nav>
        <div class="acciones">
          <button type="button" class="icono press" data-abrir-pedido data-carrito aria-label="Abrir mi pedido">
            <Icono n="bolsa" />
            <span class="insignia" data-insignia hidden>0</span>
          </button>
          <span class="tornasol solo-desk"><a class="btn brillo" href={waHref(waGeneral)} target="_blank" rel="noopener" style="min-height:46px;padding:0 20px;font-size:15px">Conversemos</a></span>
          <button type="button" class="icono press solo-movil" data-menu-boton aria-expanded="false" aria-controls="menu-movil" aria-label="Abrir menú">
            <span data-menu-icono="abrir"><Icono n="menu" s={24} /></span>
            <span data-menu-icono="cerrar" hidden><Icono n="cerrar" s={24} /></span>
          </button>
        </div>
      </div>
    </header>

    <nav id="menu-movil" class="menu-m" aria-label="Menú" data-menu style={`background:#14122C url(${fondoMenu.src}) center/cover no-repeat`} inert>
      <div class="fondo"></div>
      <div class="cuerpo">
        {MENU.map((m) => <a class="item press" href={m.href} aria-current={seccion === m.id ? 'page' : undefined}>{m.label}</a>)}
        <a class="item press" href="/preguntas/" aria-current={seccion === 'preguntas' ? 'page' : undefined}>Preguntas frecuentes</a>
        <div style="flex:1;min-height:32px"></div>
        <BotonWa msg={waGeneral} full />
        <p class="ps" style="margin-top:16px;text-align:center">{ajustes.ciudad}</p>
      </div>
    </nav>

    <main id="contenido" class="main">
      <slot />
    </main>

    <footer class="pie">
      <div class="wrap">
        <div class="stack g10">
          <Image src={lockup} alt="Alas de Expansión" width={190} widths={[190, 380]} sizes="190px" style="margin-bottom:8px" />
          <span class="ps">Expande tu conciencia, expande tu ser.</span>
          <span class="ps">{ajustes.ciudad}</span>
          {(ajustes.instagram || ajustes.facebook) && (
            <span class="fila" style="gap:16px">
              {ajustes.instagram && <a href={ajustes.instagram} target="_blank" rel="noopener">Instagram</a>}
              {ajustes.facebook && <a href={ajustes.facebook} target="_blank" rel="noopener">Facebook</a>}
            </span>
          )}
        </div>
        <div class="stack g6">
          <span class="lbl lbl-s">Explora</span>
          <a href="/experiencias/">Experiencias</a><a href="/agenda/">Agenda</a><a href="/productos/">Productos</a><a href="/bitacora/">Bitácora</a><a href="/consultas/">Consultas</a>
        </div>
        <div class="stack g6">
          <span class="lbl lbl-s">Cuidado</span>
          <a href="/esencia/">Nuestra esencia</a><a href="/preguntas/">Preguntas frecuentes y cuidado</a><a href="/legal/participacion/">Condiciones de participación</a><a href="/legal/envios/">Envíos y devoluciones</a>
        </div>
        <div class="stack g6">
          <span class="lbl lbl-s">Legal</span>
          <a href="/legal/datos/">Política de datos</a><a href="/legal/terminos/">Términos y condiciones</a>
          {ga && <button type="button" class="enlace" data-cookies-abrir style="font-size:15px;color:var(--texto-2);font-weight:400;min-height:32px">Preferencias de cookies</button>}
        </div>
      </div>
    </footer>

    {!sinFab && (
      <span class="tornasol fab">
        <a class="btn brillo press" href={waHref(waGeneral)} target="_blank" rel="noopener" aria-label="Conversemos por WhatsApp"><Icono n="wa" s={28} /></a>
      </span>
    )}

    <!-- Pedido -->
    <button type="button" class="velo-ui" data-velo aria-label="Cerrar" tabindex="-1"></button>
    <aside class="cajon" aria-label="Tu pedido" data-pedido aria-hidden="true">
      <div style="display:flex;justify-content:space-between;align-items:center;padding:22px 16px 10px 30px">
        <h2>Tu pedido</h2>
        <button type="button" class="cerrar press" data-cerrar aria-label="Cerrar pedido"><Icono n="cerrar" /></button>
      </div>
      <div class="cuerpo">
        <div data-pedido-vacio class="stack g18" style="padding-top:40px;align-items:flex-start">
          <p style="margin:0;font-size:18px;line-height:1.5">Tu pedido está vacío. Descubre los productos de la tierra.</p>
          <a class="btn b-terra" href="/productos/">Ver productos</a>
        </div>
        <div data-pedido-lleno class="stack g18" hidden>
          <div data-pedido-items class="stack g18"></div>
          <div style="display:flex;justify-content:space-between;font-size:17px;font-weight:600"><span>Subtotal</span><span data-subtotal></span></div>
          <p style="margin:0;font-size:14px;line-height:1.5;color:#5e5670">{ajustes.costo_envio}</p>
          <div class="campo"><label for="pd-ciudad">Ciudad</label><input id="pd-ciudad" class="inp" type="text" autocomplete="address-level2" placeholder="Ej. Medellín" data-ciudad /></div>
          <div class="campo">
            <span style="font-size:15px;font-weight:600">Entrega</span>
            <div style="display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px">
              <button type="button" class="opcion press" data-entrega="medellin" aria-pressed="true">Domicilio en Medellín</button>
              <button type="button" class="opcion press" data-entrega="nacional" aria-pressed="false">Envío nacional</button>
            </div>
          </div>
          <p class="aviso" role="alert" data-aviso-chicha hidden>Las chichas solo se entregan a domicilio en Medellín. Quítalas del pedido o cambia la entrega.</p>
        </div>
      </div>
      <div data-pedido-pie style="padding:16px 30px calc(28px + env(safe-area-inset-bottom));border-top:1px solid #e6d9c8" hidden>
        <button type="button" class="btn b-terra btn-l btn-full" data-enviar-pedido>Enviar pedido por WhatsApp</button>
        <p style="margin:10px 0 0;font-size:13px;line-height:1.5;color:#5e5670;text-align:center">Se abre WhatsApp con tu pedido ya escrito. Te confirmamos disponibilidad y total.</p>
      </div>
    </aside>

    <!-- Hojas -->
    <section class="hoja" role="dialog" aria-modal="true" aria-labelledby="h-edad" data-hoja="edad" aria-hidden="true">
      <div class="stack g14">
        <h2 id="h-edad">Contenido para mayores de edad</h2>
        <p class="txt">Las chichas son bebidas fermentadas con alcohol. ¿Tienes 18 años o más?</p>
        <div style="display:flex;gap:10px"><button type="button" class="btn b-ln" style="flex:1" data-edad="no">No</button><button type="button" class="btn b-noche" style="flex:1.4" data-edad="si">Sí, tengo 18 o más</button></div>
        <p class="sub">El exceso de alcohol es perjudicial para la salud.</p>
      </div>
    </section>
    <section class="hoja" role="dialog" aria-modal="true" aria-labelledby="h-sus" data-hoja="suscripcion" aria-hidden="true">
      <div class="stack g14">
        <span aria-hidden="true" style="display:inline-flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:50%;background:#1E1A3F;color:#E8C78A;font-size:24px">✉</span>
        <h2 id="h-sus">Revisa tu correo</h2>
        <p class="txt">Te enviamos un enlace a <strong data-sus-correo></strong> para confirmar tu suscripción. Solo empezaremos a escribirte cuando lo confirmes.</p>
        <p class="sub">Si no llega en unos minutos, revisa la carpeta de spam o de promociones.</p>
        <button type="button" class="btn b-noche btn-full" data-cerrar>Entendido</button>
      </div>
    </section>
    <slot name="hojas" />

    {ga && (
      <div class="glass" data-cookies hidden style="position:fixed;left:16px;right:16px;bottom:16px;z-index:28;max-width:560px;margin:0 auto;padding:18px 20px;border-radius:22px;background:rgba(251,246,238,.96);color:#26203C">
        <p style="margin:0 0 12px;font-size:15px;line-height:1.5">Usamos cookies de medición (Google Analytics) para saber qué partes del sitio sirven más. Solo se activan si las aceptas. <a href="/legal/datos/" style="color:#4A2C6E">Política de datos</a></p>
        <div style="display:flex;gap:10px"><button type="button" class="btn b-ln" style="flex:1;min-height:46px" data-cookies-no>Rechazar</button><button type="button" class="btn b-noche" style="flex:1;min-height:46px" data-cookies-si>Aceptar</button></div>
      </div>
    )}

    <div class="asomo glass" role="status" data-asomo inert>
      <div style="display:flex;gap:12px;align-items:center"><img alt="" data-asomo-img width="64" height="64" /><div style="display:flex;flex-direction:column;gap:2px;flex:1;min-width:0"><span class="oro">Agregado a tu pedido</span><span style="font-family:var(--display);font-size:19px;color:#1E1A3F" data-asomo-nombre></span><span style="font-size:14px;color:#5E5670" data-asomo-cant></span></div></div>
      <div style="display:flex;gap:8px;margin-top:12px"><button type="button" class="btn b-ln" style="flex:1;min-height:44px;font-size:15px;padding:0 12px" data-asomo-cerrar>Seguir explorando</button><button type="button" class="btn b-terra" style="flex:1;min-height:44px;font-size:15px;padding:0 12px" data-abrir-pedido>Ver pedido</button></div>
    </div>
    <div class="toast" role="status" aria-live="polite" data-toast></div>
    <img class="volador" alt="" aria-hidden="true" data-volador />

    <script type="application/json" id="datos-productos" set:html={JSON.stringify(datosPedido)}></script>
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>
